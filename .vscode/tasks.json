{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "clang-debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "CTest: run",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "clang-debug"],
      "group": { "kind": "test", "isDefault": true },
      "dependsOn": "CMake: build",
      "problemMatcher": []
    }
  ]
}
