# clangd configuration for toby.
#
# clangd's `--clang-tidy` flag does NOT run `misc-include-cleaner` -- clangd
# disables that check and substitutes its own native IncludeCleaner, which
# ships with missing-include diagnostics OFF by default. That is why "you used
# std::array and never included <array>" is invisible in the editor even though
# `clang-tidy-20` reports it from the command line.
Diagnostics:
  MissingIncludes: Strict
  UnusedIncludes: Strict

# clangd uses Clang's CUDA parser, which does not accept these nvcc options.
# Apply this to sources and headers that inherit a CUDA compile command.
CompileFlags:
  Remove: [-forward-unknown-to-host-compiler, '-ccbin=*', '-arch=*']

---
# Public C++ headers may borrow an nvcc command from a CUDA includer.
# Parse them as ordinary C++ with the project's host standard library.
If:
  PathMatch: include/.*\.hpp
CompileFlags:
  Compiler: clang++
  Remove: [-x, '-std=*', '-stdlib=*']
  Add: [-xc++, -std=c++23, -stdlib=libc++]
