{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "base",
      "description": "Clang 20 with libc++ (the toolchain).",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "TOBY_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "clang-cuda",
      "displayName": "Clang 20 + libc++ Debug + CUDA runtime",
      "description": "Adds libcudart to the Debug build. Needs the CUDA toolkit; pass -DCUDAToolkit_ROOT=... if it is not in /usr/local/cuda.",
      "inherits": "clang-debug",
      "cacheVariables": { "TOBY_ENABLE_CUDA": "ON" }
    },
    {
      "name": "clang-cuda-release",
      "displayName": "Clang 20 + libc++ RelWithDebInfo + CUDA runtime",
      "inherits": "clang-release",
      "cacheVariables": { "TOBY_ENABLE_CUDA": "ON" }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "inherits": "base",
      "description": "Xcode AppleClang with the system libc++.",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "TOBY_WARNINGS_AS_ERRORS": "ON"
      }
    },

    {
      "name": "clang-debug",
      "displayName": "Clang 20 + libc++ Debug",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOBY_HARDENING": "extensive"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang 20 + libc++ RelWithDebInfo",
      "inherits": "clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TOBY_HARDENING": "fast"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang 20 Debug + clang-tidy",
      "inherits": "clang-debug",
      "cacheVariables": { "TOBY_ENABLE_CLANG_TIDY": "ON" }
    },
    {
      "name": "clang-asan",
      "displayName": "Clang 20 Debug + Address/UB sanitizers",
      "inherits": "clang-debug",
      "cacheVariables": {
        "TOBY_SANITIZE_ADDRESS": "ON",
        "TOBY_SANITIZE_UNDEFINED": "ON",
        "TOBY_HARDENING": "debug"
      }
    },
    {
      "name": "clang-tsan",
      "displayName": "Clang 20 Debug + ThreadSanitizer",
      "inherits": "clang-debug",
      "cacheVariables": {
        "TOBY_SANITIZE_THREAD": "ON",
        "TOBY_HARDENING": "debug"
      }
    },

    {
      "name": "macos-debug",
      "displayName": "macOS AppleClang Debug",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOBY_HARDENING": "extensive"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS AppleClang RelWithDebInfo",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TOBY_HARDENING": "fast"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS AppleClang Address/UB sanitizers",
      "inherits": "macos-debug",
      "cacheVariables": {
        "TOBY_SANITIZE_ADDRESS": "ON",
        "TOBY_SANITIZE_UNDEFINED": "ON",
        "TOBY_HARDENING": "debug"
      }
    },
    {
      "name": "macos-tsan",
      "displayName": "macOS AppleClang ThreadSanitizer",
      "inherits": "macos-debug",
      "cacheVariables": {
        "TOBY_SANITIZE_THREAD": "ON",
        "TOBY_HARDENING": "debug"
      }
    },
    {
      "name": "macos-tidy",
      "displayName": "macOS matched LLVM Debug + clang-tidy",
      "description": "Requires a matched upstream LLVM clang++ and clang-tidy on PATH.",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++",
        "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++",
        "TOBY_HARDENING": "extensive",
        "TOBY_ENABLE_CLANG_TIDY": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-tidy",    "configurePreset": "clang-tidy" },
    { "name": "clang-asan",    "configurePreset": "clang-asan" },
    { "name": "clang-tsan",    "configurePreset": "clang-tsan" },
    { "name": "clang-cuda",    "configurePreset": "clang-cuda" },
    { "name": "clang-cuda-release", "configurePreset": "clang-cuda-release" },
    { "name": "macos-debug",   "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" },
    { "name": "macos-asan",    "configurePreset": "macos-asan" },
    { "name": "macos-tsan",    "configurePreset": "macos-tsan" },
    { "name": "macos-tidy",    "configurePreset": "macos-tidy" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "clang-debug", "configurePreset": "clang-debug", "inherits": "base" },
    { "name": "clang-asan",  "configurePreset": "clang-asan",  "inherits": "base" },
    { "name": "clang-tsan",  "configurePreset": "clang-tsan",  "inherits": "base" },
    { "name": "clang-cuda",  "configurePreset": "clang-cuda",  "inherits": "base" },
    { "name": "macos-debug", "configurePreset": "macos-debug", "inherits": "base" },
    { "name": "macos-asan",  "configurePreset": "macos-asan",  "inherits": "base" },
    { "name": "macos-tsan",  "configurePreset": "macos-tsan",  "inherits": "base" }
  ]
}
